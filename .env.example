# Copie este archivo a `.env`. Los valores por defecto funcionan tal cual.
POSTGRES_USER=contable
POSTGRES_PASSWORD=contable
POSTGRES_DB=contable
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Puertos publicados en la máquina anfitriona (cámbielos si ya están ocupados).
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Solo necesaria para ejecutar el backend fuera de Docker.
# Dentro de docker compose, la URL la inyecta el propio compose apuntando al servicio `db`.
DATABASE_URL=postgresql+psycopg://contable:contable@localhost:5432/contable

# Origen del frontend autorizado por CORS.
CORS_ORIGINS=http://localhost:3000
